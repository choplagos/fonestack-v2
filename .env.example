# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini AI (server-side only; never use NEXT_PUBLIC_ for the API key)
GEMINI_API_KEY=your_gemini_api_key_here

# Resend invoice email (server-side only; never use NEXT_PUBLIC_ for the API key)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Fonestack <invoices@your-verified-domain.example>

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.fonestack.com.ng

# IndexNow API Configuration
# Get your API key from: https://www.indexnow.org/
# Your unique key: f1300c4472f44e86b1455c5ab97e52a1
INDEXNOW_API_KEY=f1300c4472f44e86b1455c5ab97e52a1

# Optional: Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
